# Postgres (Neon). In Vercel: Storage → Neon → connect to project (sets DATABASE_URL automatically).
# Without it the app runs with the in-memory store (data is lost on restart).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: appointment e-mails via Resend (https://resend.com). Without the key
# bookings work the same, just without e-mail.
RESEND_API_KEY=
# Sender on a domain verified in Resend. Until then Resend only delivers to
# the Resend account's own address (fine for the store notice).
EMAIL_FROM="Ópticas Cardani <citas@opticascardani.com>"
# Where the store receives each new booking (default info@opticascardani.com)
STORE_NOTIFY_EMAIL=
